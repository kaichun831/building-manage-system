# ================================================================
# 大廈管理委員會系統 - 環境變數範本
# 複製此檔案為 .env.local 並填入實際值
# ================================================================

# ── JWT ──────────────────────────────────────────────────────────
# 至少 32 個字元的隨機字串
JWT_SECRET=your-secret-key-min-32-chars

# ── Firebase Client（前端用）────────────────────────────────────
# Firebase Console > 專案設定 > 一般 > 您的應用程式
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Firebase Admin（後端用）─────────────────────────────────────
# Firebase Console > 專案設定 > 服務帳戶 > 產生新的私密金鑰
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key\n-----END PRIVATE KEY-----\n"

# ── 資料庫選擇 ───────────────────────────────────────────────────
# firebase（預設）或 supabase
DB_PROVIDER=firebase

# ── Supabase（DB_PROVIDER=supabase 時填入）──────────────────────
# Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 圖片上傳選擇 ─────────────────────────────────────────────────
# firebase（預設）或 s3
UPLOAD_PROVIDER=firebase

# ── AWS S3（UPLOAD_PROVIDER=s3 時填入）──────────────────────────
# IAM > Users > Security credentials > Create access key
AWS_S3_REGION=ap-northeast-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
# CloudFront CDN URL（選填，有設定 CDN 時填入）
# AWS_CLOUDFRONT_URL=https://xxxxxx.cloudfront.net

# ── AWS SES（忘記密碼寄信）──────────────────────────────────────
# IAM > Users > Security credentials > Create access key
# 需先在 SES 驗證寄件網域
AWS_SES_REGION=ap-northeast-1
AWS_SES_ACCESS_KEY_ID=your-ses-access-key-id
AWS_SES_SECRET_ACCESS_KEY=your-ses-secret-access-key
AWS_SES_FROM_EMAIL=noreply@your-domain.com

# ── 系統網址 ─────────────────────────────────────────────────────
# 重設密碼信件中的連結網址
NEXT_PUBLIC_BASE_URL=https://your-domain.com
